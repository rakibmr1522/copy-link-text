{
  "manifest_version": 3,
  "name": "Copy Link Text",
  "version": "1.5.0",
  "description": "Copy the main visible text of a link from the right-click menu.",
  "permissions": ["contextMenus", "activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}